# Server
PORT=3000
NODE_ENV=development
# Set to the number of reverse proxies in front of the app (usually 1) so login
# rate limits count real client IPs. Leave unset when clients connect directly.
TRUST_PROXY=

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platform?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Default region used when a request has no resolvable country (dev only —
# production must always resolve a real country, never fall back silently)
DEFAULT_COUNTRY_CODE=NG

# Redis (BullMQ scheduler — PK countdown/settle, game round open/lock)
REDIS_URL=redis://localhost:6379

# Paystack (payments) — leave unset to fall back to MockPaymentProvider for
# local dev; real payments will NOT work until this is set.
PAYSTACK_SECRET_KEY=

# Agora (live streaming RTC tokens) — leave unset to fall back to
# MockRtcProvider; issued tokens will be fake and unusable by a real client.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Brevo (transactional email) — leave unset to fall back to
# MockEmailProvider, which logs instead of sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Platform

# Video storage — any S3-compatible bucket (Cloudflare R2, AWS S3, Spaces, MinIO).
# Leave S3_BUCKET unset to use a mock that stores nothing (dev only); in production
# uploads answer 503 until this is set.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare R2: region "auto" AND the endpoint are both required:
#   S3_REGION=auto
#   S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
# AWS S3: a real region (e.g. us-east-1) and no endpoint.
S3_REGION=auto
S3_ENDPOINT=
# The address videos are played from. The simplest setup serves them through this
# API (the bucket can stay private):
#   S3_PUBLIC_BASE_URL=https://<your-api>/api/v1/storage/files
# For real traffic, put a CDN / public bucket domain here instead.
S3_PUBLIC_BASE_URL=
# Upload cap in bytes (default 200 MB)
MAX_VIDEO_BYTES=

# Identity verification: secret used to fingerprint ID numbers (falls back to JWT_ACCESS_SECRET)
KYC_HASH_SECRET=

# Image uploads (profile photos) — ImgBB key, kept on the server only.
IMGBB_API_KEY=

# Phone push notifications — set to "expo" to enable (off by default).
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=

# Timezone offset in minutes for "daily" mission resets / valid days (default 60 = Lagos)
MISSION_DAY_OFFSET_MINUTES=60
