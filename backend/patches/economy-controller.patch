--- orig/src/economy/economy.controller.ts	2026-09-29 03:56:18.000000000 +0000
+++ src/economy/economy.controller.ts	2026-09-29 21:08:36.968465243 +0000
@@ -257,6 +257,37 @@
       }
     }
 
+    // A gift to someone seated in a party room may also have moved a running Room PK (multi-guest
+    // PK, see economy/room-pk-score.ts). Push the fresh scores to the room so every screen's
+    // scoreboard updates without waiting for its next poll. Best effort, like the block above.
+    const giftContext = (transaction as { context?: string | null }).context;
+    const giftContextId = (transaction as { contextId?: string | null }).contextId;
+    if (giftContext === 'ROOM' && giftContextId) {
+      try {
+        const roomPk = await this.prisma.roomPk.findFirst({
+          where: { roomId: giftContextId, status: 'ACTIVE' },
+          include: { participants: { select: { userId: true, side: true, score: true } } },
+        });
+        if (roomPk) {
+          let a = 0n;
+          let b = 0n;
+          for (const p of roomPk.participants) {
+            if (p.side === 'A') a += p.score;
+            else if (p.side === 'B') b += p.score;
+          }
+          this.realtime.broadcastRoomState(giftContextId, {
+            roomId: giftContextId,
+            action: 'ROOM_PK_SCORE',
+            roomPkId: roomPk.id,
+            scores: roomPk.participants.map((p) => ({ userId: p.userId, score: p.score.toString() })),
+            sideTotals: roomPk.mode === 'TEAMS' ? { A: a.toString(), B: b.toString() } : null,
+          });
+        }
+      } catch {
+        /* the score is saved; the scoreboard also polls GET /rooms/:id/pk */
+      }
+    }
+
     return transaction;
   }
 }
